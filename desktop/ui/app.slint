                border-radius: 16px;
                border-width: 1px;
                border-color: #e2e8f0;
                drop-shadow-blur: 8px;
                drop-shadow-color: #0f172a06;
                drop-shadow-offset-y: 2px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: center;

                    // QR Code Frame
                    Rectangle {
