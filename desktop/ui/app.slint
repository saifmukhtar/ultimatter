                height: 38px;

                HorizontalLayout {
                    padding: 3px;
                    spacing: 4px;
                    
                    // Local Tab
                    Rectangle {
                        background: root.active_tab == "local" ? #ffffff : transparent;
                        border-radius: 8px;
