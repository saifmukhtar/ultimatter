import { Button, ScrollView, LineEdit } from "std-widgets.slint";

component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: true;
    callback toggled();

    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: checked ? #10b981 : #cbd5e1;
    animate background { duration: 150ms; easing: ease-in-out; }

    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    thumb := Rectangle {
        x: checked ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000025;
        drop-shadow-offset-y: 1px;
        animate x { duration: 150ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
    }
}

export component AppWindow inherits Window {
    title: "Ultimatter Control Panel";
    min-width: 440px;
    min-height: 720px;
    max-width: 480px;
    preferred-width: 460px;
    preferred-height: 760px;
    background: #f1f5f9;
    default-font-family: "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, sans-serif";

    in-out property <string> status_text: "Agents Offline";
    in-out property <bool> status_online: false;
    in-out property <int> active_count: 0;
    in-out property <string> agent_chip_text: "Antigravity (:46639)";
    
    in-out property <string> active_tab: "local"; // "local" | "tailscale"
    in-out property <string> local_sub_mode: "ip"; // "ip" | "domain"
    
    in-out property <image> qr_image;
    in-out property <string> direct_link: "Loading connection link...";
    in-out property <string> copy_btn_text: "Copy";
    
    in-out property <bool> remote_access_enabled: true;
    in-out property <bool> bubble_enabled: false;
    
    in-out property <string> local_domain: "ultramarine.local";
    in-out property <string> tailscale_state: "stopped"; // "connected" | "stopped" | "not_installed"
    
    in-out property <bool> show_smart_card: false;
    in-out property <bool> show_rename_modal: false;
    in-out property <string> rename_input_text: "";
    in-out property <string> version_text: "v1.0.0";

    callback set_mode(string);
    callback set_local_sub_mode(string);
    callback copy_link();
    callback toggle_remote_access();
    callback toggle_bubble();
    callback reset_token();
    callback open_rename_dialog();
    callback save_new_domain(string);
    callback close_rename_dialog();
    callback copy_opencode_cmd();
    callback copy_tailscale_cmd();
    callback open_root_ca_link();

    // Rename Modal Overlay
    if (root.show_rename_modal) : Rectangle {
        z: 100;
        background: #00000066;

        TouchArea {
            // Click outside closes modal
            clicked => { root.close_rename_dialog(); }
        }

        Rectangle {
            width: 380px;
            height: 190px;
            background: #ffffff;
            border-radius: 16px;
            border-width: 1px;
            border-color: #e2e8f0;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            drop-shadow-offset-y: 6px;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                Text {
                    text: "✏️ Rename Local Domain";
                    font-size: 14px;
                    font-weight: 700;
                    color: #0f172a;
                }

                Text {
                    text: "Enter new mDNS host (e.g. macbook.local):";
                    font-size: 11px;
                    color: #64748b;
                }

                input := LineEdit {
                    text: root.rename_input_text;
                    placeholder-text: "my-pc.local";
                    edited => { root.rename_input_text = self.text; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Rectangle {
                        background: #f1f5f9;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #cbd5e1;
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        TouchArea { clicked => { root.close_rename_dialog(); } }
                        Text { text: "Cancel"; font-size: 11px; font-weight: 600; color: #475569; }
                    }

                    Rectangle {
                        background: #0284c7;
                        border-radius: 6px;
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        TouchArea { clicked => { root.save_new_domain(input.text); } }
                        Text { text: "Save Domain"; font-size: 11px; font-weight: 700; color: #ffffff; }
                    }
                }
            }
        }
