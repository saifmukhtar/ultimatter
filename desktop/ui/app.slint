                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "💡"; font-size: 14px; }
                        Text {
                            text: "Smart Quick Start & Diagnostics";
                            font-size: 12px;
                            font-weight: 700;
                            color: #0f172a;
                            vertical-alignment: center;
