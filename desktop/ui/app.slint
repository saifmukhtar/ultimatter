                                            font-size: 11px;
                                            font-family: "ui-monospace, monospace";
                                            color: #0f172a;
                                            vertical-alignment: center;
                                        }

                                        Rectangle {
                                            background: #e2e8f0;
                                            border-radius: 4px;
                                            width: 48px;
                                            height: 20px;
                                            horizontal-stretch: 0;

                                            TouchArea {
                                                clicked => { root.copy_opencode_cmd(); }
                                            }

                                            Text {
                                                text: "Copy";
                                                font-size: 10px;
                                                font-weight: 600;
                                                color: #334155;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
