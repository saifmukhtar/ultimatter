                    // Tailscale Tab
                    Rectangle {
                        background: root.active_tab == "tailscale" ? #ffffff : transparent;
                        border-radius: 8px;
                        drop-shadow-blur: root.active_tab == "tailscale" ? 2px : 0px;
                        drop-shadow-color: #00000015;

                        TouchArea {
                            clicked => { root.set_mode("tailscale"); }
