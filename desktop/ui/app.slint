import { Button, ScrollView } from "std-widgets.slint";

component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: true;
    callback toggled();

    width: 34px;
    height: 20px;
    border-radius: 10px;
    background: checked ? #10b981 : #cbd5e1;
    animate background { duration: 150ms; easing: ease-in-out; }

    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    thumb := Rectangle {
        x: checked ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #ffffff;
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000020;
        drop-shadow-offset-y: 1px;
        animate x { duration: 150ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
    }
}

export component AppWindow inherits Window {
