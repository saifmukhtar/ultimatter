                Rectangle {
                    background: #f1f5f9;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 3px;
                        padding-bottom: 3px;

                        Text {
                            text: root.version_text;
                            font-size: 10px;
                            font-weight: 600;
                            color: #64748b;
                        }
                    }
                }
            }
        }
    }
}
