                    // OpenCode Row
                    Rectangle {
                        background: #ffffff;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #e2e8f0;

                        HorizontalLayout {
                            padding: 10px;
                            spacing: 10px;
