                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    alignment: space-between;

                    // Brand Title
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        
                        Text {
                            text: "🚀";
                            font-size: 24px;
                            vertical-alignment: center;
                        }
                        
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;

                            Text {
                                text: "Ultimatter";
                                font-size: 15px;
                                font-weight: 700;
                                color: #0f172a;
                                letter-spacing: -0.2px;
                            }
                            Text {
                                text: "Universal AI Gateway";
                                font-size: 11px;
                                color: #64748b;
                            }
                        }
                    }

                    // Status Pill
                    Rectangle {
                        background: root.status_online ? #dcfce7 : #f1f5f9;
                        border-width: 1px;
                        border-color: root.status_online ? #bbf7d0 : #e2e8f0;
                        border-radius: 12px;
                        height: 26px;
                        horizontal-stretch: 0;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            Rectangle {
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: root.status_online ? #10b981 : #94a3b8;
                            }

